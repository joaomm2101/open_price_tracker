*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# Price data you import (and the *.rejected.csv reports the importer writes next to it)
*.csv
*.tsv

# Secrets and local configuration (never commit real credentials)
.env
.env.*
!.env.example
*.pem
*.key
docker-compose.override.yml

# Editors and IDEs
.vscode/
.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
