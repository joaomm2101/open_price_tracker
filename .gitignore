# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments (uv recreates it with `uv sync`)
.venv/
venv/
env/

# Tests, coverage and tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
